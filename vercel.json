{
  "cleanUrls": true,
  "trailingSlash": true,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/blog/category/:slug{/}?",
      "destination": "/blog/category.html"
    },
    {
      "source": "/blog/:slug((?!list|standard|index|assets|wp-content|wp-includes)[^/]+){/}?",
      "destination": "/blog/post.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(woff|woff2|ttf|eot|otf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
