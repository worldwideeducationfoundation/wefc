{
  "cleanUrls": true,
  "trailingSlash": true,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/blog/category/:slug/?",
      "destination": "/blog/category.html"
    },
    {
      "source": "/blog/:slug((?!list|standard|index|assets|wp-content|wp-includes)[^/]+)/?",
      "destination": "/blog/post.html"
    }
  ]
}