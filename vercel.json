{
  "cleanUrls": true,
  "trailingSlash": true,
  "framework": "vite",
  "rewrites": [
    { "source": "/blog/category/:slug", "destination": "/blog/category.html" },
    { "source": "/blog/category/:slug/", "destination": "/blog/category.html" },
    { "source": "/blog/list", "destination": "/blog/list.html" },
    { "source": "/blog/list/", "destination": "/blog/list.html" },
    { "source": "/blog/standard", "destination": "/blog/standard.html" },
    { "source": "/blog/standard/", "destination": "/blog/standard.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/", "destination": "/blog/index.html" },
    { "source": "/blog/index", "destination": "/blog/index.html" },
    { "source": "/blog/index/", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/post.html" },
    { "source": "/blog/:slug/", "destination": "/blog/post.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(woff|woff2|ttf|eot|otf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
