# Copy to .env.local for local development. On Hostinger, enter the same
# names in the Node.js app's Environment Variables panel. `.env*` files are
# gitignored — never commit real values.

# ── Site ──────────────────────────────────────────────────────────────
# The canonical address, used for canonical URLs, social cards, robots.txt
# and the sitemap. Read at build time, so changing it needs a redeploy.
NEXT_PUBLIC_SITE_URL=https://wefcanada.org

# ── Database (Hostinger: hPanel -> Databases -> MySQL Databases) ──────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=u123456789_wefc
DB_USER=u123456789_wefc
DB_PASSWORD=
# Or instead of the five above:
# DATABASE_URL=mysql://user:password@localhost:3306/u123456789_wefc

# ── Uploaded images ───────────────────────────────────────────────────
# An absolute path to a folder OUTSIDE the app's own directory, so that a
# redeploy from GitHub can never replace or delete it. Created if missing.
# Example on Hostinger: /home/u123456789/wefc-uploads
UPLOAD_DIR=

# ── First admin account ───────────────────────────────────────────────
# Any long random phrase. /admin/setup asks for it before it will create the
# first admin, so nobody else can claim a fresh install. Can be removed once
# your account exists.
ADMIN_SETUP_KEY=

# ── Optional ──────────────────────────────────────────────────────────
# Keeps admin forms working across redeploys and multiple processes.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
