# Vite Static Project Variables (Exposed client-side securely via VITE_ prefix)
VITE_SANITY_PROJECT_ID="wgy1a1gg"
VITE_SANITY_DATASET="production"
VITE_SANITY_API_VERSION="2026-07-08"

# Supabase — read at BUILD time by vite.config.js and inlined into the bundle,
# which is why these two carry no VITE_ prefix: Hostinger injects them under
# these exact names once the Supabase database is linked to the app, so there
# is nothing to set there by hand. Copy them into a local .env to test forms.
#
# SUPABASE_API_KEY must be the PUBLIC anon key (Supabase dashboard →
# Project Settings → API → "anon public"). Never put the service_role key here:
# anything in these two variables ships to the browser. Row Level Security in
# supabase/schema.sql is what keeps the data safe.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_API_KEY="your-anon-public-key"

# Next.js Application Variables
NEXT_PUBLIC_SANITY_PROJECT_ID="wgy1a1gg"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_VERSION="2026-05-15"
